/****************************************************************
PROJECT NAME : BASIC DM DOMAIN MAPPING USING A SMALL DATASET
DOMAIN : DM
TOPIC : SUBJID
CREATED_BY : SHRIKANT KUMAR 
DATE : 16-OCT-2026
***********************************************************/
data raw_dm_final;
    input subjid $ site $ sex $ race1 :$20. race2 :$20. 
          birthdt :$11. icdt :$11. randdt :$11. 
          arm_raw :$20. fdosedt :$11. ldosedt :$11. 
          deathdt :$11. country :$10.;
    datalines;
101 05 Male White . 10-JAN-1980 01-MAR-2024 03-MAR-2024 DrugA 05-MAR-2024 30-APR-2024 . USA
102 05 Female Asian Black 15-JUN-1975 02-MAR-2024 04-MAR-2024 Placebo 06-MAR-2024 . . USA
103 06 Male Black . 20-SEP-1992 03-MAR-2024 . . . . . USA
104 06 Female White . 25-DEC-1988 04-MAR-2024 06-MAR-2024 DrugA 07-MAR-2024 15-MAR-2024 20-MAR-2024 IND
105 07 Male Asian . 11-NOV-1970 05-MAR-2024 07-MAR-2024 Placebo 08-MAR-2024 . . IND
;
run;


data dm01;
set raw_dm_final;

STUDYID="XYZ-456";    /* STUDY_IDENTIFIER,CHARACTER,IDENTIFIER,REQUIRED */ 
DOMAIN="DM";            /* DOMAIN , CHAR, IDENTIFIER , REQURED*/
USUBJID=CATX("-",STUDYID,SITE,SUBJID); /* UNIQUE SUBJECT ID ,CHARCATER,IDENTIFIER ,REQUIRED*/
SUBJID=SUBJID; /* SUBJECT_ID ,CHAR,IDENTIFIER ,REQUIRED */

SITEID=SITE; /* SITE-IDENTIFIER,CHAR,RECORD_QUALIFIER,REQUIRED*/

BIRTHDT_SAS=INPUT(BIRTHDT,DATE11.); 
ICDT_SAS=INPUT(ICDT,DATE11.);
FORMAT BIRTHDT_SAS ICDT_SAS DATE9.;

AGE=INTCK("YEAR",BIRTHDT_SAS,ICDT_SAS)-(MDY(MONTH(BIRTHDT_SAS),DAY(BIRTHDT_SAS),YEAR(ICDT_SAS))> ICDT_SAS);
 
AGEU="YEARS"; 

if upcase(sex)="MALE" THEN SEX="M";
ELSE SEX="F";




IF RACE1 NE "." AND RACE1 NE " " THEN RACE=UPCASE(RACE1);
IF (RACE1 NE . OR  RACE1 NE " ") AND (RACE2 NE . OR RACE2 NE " ") THEN RACE="MULTIPLE";

IF ARM_RAW = "." OR ARM_RAW = " " THEN DO ;
ARMCD="NOTASSGN";
ARM="NOT ASSIGNED";
ACTARMCD="NOTASSGN";
ACTARM="NOT ASSIGNED";
END;

IF UPCASE(ARM_RAW)="DRUGA" THEN DO;
ARMCD="DrugA";
ARM="Drug A 100 mg ";
ACTARMCD="DrugA";
ACTARM="Drug A 100 mg ";
END;

IF UPCASE(ARM_RAW)="PLACEBO" THEN DO;
ARMCD="PBO";
ARM="Placebo";
ACTARMCD="PBO";
ACTARM="Placebo";
END;

COUNTRY=UPCASE(COUNTRY);

FDOSEDT_SAS=INPUT(FDOSEDT,DATE11.);
LDOSEDT_SAS=INPUT(LDOSEDT,DATE11.);
DEATHDT_SAS=INPUT(DEATHDT,DATE11.);

FORMAT FDOSEDT_SAS LDOSEDT_SAS DEATHDT_SAS DATE9.;
RFSTDTC=PUT(FDOSEDT_SAS,IS8601DA.);
IF DEATHDT_SAS NE . THEN RFENDTC=PUT(DEATHDT_SAS,IS8601DA.);
ELSE RFENDTC=PUT(LDOSEDT_SAS,IS8601DA.);

DTHDTC=PUT(DEATHDT_SAS,IS8601DA.);

IF DEATHDT_SAS NE . THEN DO;
DTHDTC=PUT(DEATHDT_SAS,IS8601DA.);
DTHFL="Y";
END;

RFICDTC=PUT(ICDT_SAS,IS8601DA.);
BRTHDTC=PUT(BIRTHDT_SAS,IS8601DA.);

KEEP STUDYID DOMAIN USUBJID SUBJID RFSTDTC RFENDTC   BRTHDTC DTHDTC DTHFL RFICDTC 
AGE AGEU RACE COUNTRY SEX SITEID ARMCD ARM ACTARMCD ACTARM ;
RUN;

PROC PRINT DATA=DM01;
RUN;

